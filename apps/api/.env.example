# Copy to `.env` for local development. Never commit real secrets.

PREDICTA_API_ENV=development
PREDICTA_API_DATA_MODE=mock
PREDICTA_API_REPOSITORY=mock
PREDICTA_API_LOG_LEVEL=INFO

# PostgreSQL is the source of truth. Required when PREDICTA_API_REPOSITORY=sql.
PREDICTA_API_DATABASE_URL=postgresql+psycopg://predicta:predicta@localhost:5432/predicta

# Redis is optional cache, never a source of truth.
PREDICTA_API_REDIS_URL=

PREDICTA_API_CORS_ORIGINS=http://localhost:3000
PREDICTA_API_REQUEST_ID_HEADER=X-Request-ID

# Mock fixtures use a fixed clock so timestamps stay deterministic.
PREDICTA_API_MOCK_NOW=2026-09-09T18:00:00Z

# Opaque-session Private Beta auth. AUTH_BYPASS is a temporary hatch for
# local and staging product testing. Production refuses it at boot.
# Never put passwords here.
PREDICTA_API_AUTH_BYPASS=true
PREDICTA_API_INVITE_ALLOWLIST=
PREDICTA_API_SESSION_COOKIE_NAME=predicta_session
PREDICTA_API_CSRF_COOKIE_NAME=predicta_csrf
PREDICTA_API_CSRF_HEADER_NAME=X-CSRF-Token
PREDICTA_API_SESSION_TTL_SECONDS=604800

# Staging / production refuse mock repository and data_mode=mock at boot.
# There is no staging mock escape hatch. Copy these values for a Private Beta host:
# PREDICTA_API_ENV=staging
# PREDICTA_API_REPOSITORY=sql
# PREDICTA_API_DATA_MODE=live
# PREDICTA_API_AUTH_BYPASS=false
# Temporary product testing on a staging host (never production):
# PREDICTA_API_AUTH_BYPASS=true
# PREDICTA_API_INVITE_ALLOWLIST=beta@example.com
# PREDICTA_API_CORS_ORIGINS=https://staging.example.com
# PREDICTA_API_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/predicta
# Provision invited users with:
# PREDICTA_API_BOOTSTRAP_PASSWORD=... python -m app.auth.provision beta@example.com
# Compose boot: docs/infra/staging-compose.md and infra/containers/.env.staging.example

# Football 1X2 candidate (not champion, not production). Real artefact + PIT parquet.
# Paths may be filesystem paths or file:// URIs. Missing artefact → RFC 9457, never mock.
PREDICTA_API_FOOTBALL_MODEL_VERSION=football-elo-v1-candidate
PREDICTA_API_FOOTBALL_REGISTRY_DIR=../../workers/ml/var/registry
PREDICTA_API_FOOTBALL_DATASET_PATH=../../workers/ingestion/var/football-1x2-history.parquet
PREDICTA_API_FOOTBALL_PREMATCH_DATASET_PATH=../../workers/ingestion/var/football-1x2-prematch.parquet
PREDICTA_API_FOOTBALL_RAW_ARCHIVE_DIR=../../workers/ingestion/var/raw
# Staging volume (see infra/containers/compose.staging.yml):
# PREDICTA_API_FOOTBALL_REGISTRY_DIR=/data/football/registry
# PREDICTA_API_FOOTBALL_DATASET_PATH=/data/football/datasets/football-1x2-history.parquet
# PREDICTA_API_FOOTBALL_PREMATCH_DATASET_PATH=/data/football/datasets/football-1x2-prematch.parquet
# PREDICTA_API_FOOTBALL_RAW_ARCHIVE_DIR=/data/football/raw

# AI Analyst narrator. LLM is optional and never a source of truth.
PREDICTA_API_ANALYST_NARRATOR=deterministic
PREDICTA_API_ANALYST_LLM_MODEL=mock-explainer-0.1
PREDICTA_API_ANALYST_PROMPT_VERSION=analyst-prompt-0.1
PREDICTA_API_ANALYST_LLM_TIMEOUT_SECONDS=2

# AI Picks V0.1 thresholds and the explicit candidate universe.
PREDICTA_API_AI_PICKS_CANDIDATE_MATCH_IDS=["mth_football-sportmonks-19719892"]
PREDICTA_API_AI_PICKS_MINIMUM_EDGE=0
PREDICTA_API_AI_PICKS_MINIMUM_EV=0
PREDICTA_API_AI_PICKS_MINIMUM_MODEL_PROBABILITY=0
PREDICTA_API_AI_PICKS_MAXIMUM_ODDS_AGE_SECONDS=86400

# The ingestion worker uses the same PostgreSQL instance. Provider API keys
# belong in workers/ingestion/.env.example, never in this repository with values.
