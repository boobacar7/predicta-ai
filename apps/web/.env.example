# Deployment target. This is NOT NODE_ENV: a local `next build` is a production
# build but still a development deployment. Staging and production both refuse
# mock fixtures. There is no staging mock escape hatch.
# Values: development | staging | production
NEXT_PUBLIC_PREDICTA_ENV=development

# Default data access mode for every resource.
# Phase 1 serves fictional fixtures. Switch to `http` once the API is available.
# Values: mock | http
NEXT_PUBLIC_PREDICTA_DATA_SOURCE=mock

# Staging Private Beta (mock is refused at boot). These are build-time values.
# NEXT_PUBLIC_PREDICTA_ENV=staging
# NEXT_PUBLIC_PREDICTA_DATA_SOURCE=http
# NEXT_PUBLIC_PREDICTA_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_PREDICTA_HTTP_RESOURCES=
# NEXT_PUBLIC_PREDICTA_MOCK_RESOURCES=
# NEXT_PUBLIC_PREDICTA_ALLOW_MOCK_IN_PROD=false
# Compose boot: docs/infra/staging-compose.md

# Per-resource overrides for the mock -> HTTP migration, comma separated.
# A resource listed here is read over HTTP regardless of the default mode.
# Valid resources: dashboard, sports, leagues, matches, picks, football_ai_picks,
#                  football_ai_analyst, football_predictions, football_value,
#                  value, performance, teams, players, analyst
# `football_ai_picks` is GET /football/ai-picks, routed separately from the
# generic `picks` list because they are distinct endpoints in the contract.
# `football_predictions` is GET /football/predictions/{match_id}.
# `football_value` is GET /football/value/{match_id}, not legacy GET /value.
# Example: NEXT_PUBLIC_PREDICTA_HTTP_RESOURCES=football_ai_picks,football_ai_analyst,football_predictions,football_value,matches
# Point football_ai_picks, football_ai_analyst and matches at HTTP to consume
# the identity-fixed engine instead of fixtures.
NEXT_PUBLIC_PREDICTA_HTTP_RESOURCES=

# The inverse override: keep these resources on fixtures while the default is http.
NEXT_PUBLIC_PREDICTA_MOCK_RESOURCES=

# Base URL of the versioned API, without a trailing slash.
# Required as soon as any resource reads over HTTP.
# Example: NEXT_PUBLIC_PREDICTA_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_PREDICTA_API_BASE_URL=

# Abort budget for a single API read, in milliseconds.
NEXT_PUBLIC_PREDICTA_REQUEST_TIMEOUT_MS=10000

# Cookie-authenticated API. The session cookie is HttpOnly and is never written
# to localStorage. The CSRF cookie is readable so POST can send X-CSRF-Token.
NEXT_PUBLIC_PREDICTA_CSRF_COOKIE_NAME=predicta_csrf
NEXT_PUBLIC_PREDICTA_CSRF_HEADER_NAME=X-CSRF-Token

# Escape hatch for a deliberate mock demo on a production deployment only.
# Ignored in staging (staging cannot serve mock). Leave false unless you are
# knowingly publishing fictional data on a production demo host.
NEXT_PUBLIC_PREDICTA_ALLOW_MOCK_IN_PROD=false
