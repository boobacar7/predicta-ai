# Copy to `.env`. Never commit real secrets or live API keys.

PREDICTA_INGESTION_ENV=development
PREDICTA_INGESTION_DATA_MODE=mock
PREDICTA_INGESTION_ENABLE_LIVE=false
PREDICTA_INGESTION_MOCK_NOW=2026-09-09T18:00:00Z

# Same PostgreSQL as apps/api. The worker does not create a second database.
PREDICTA_INGESTION_DATABASE_URL=postgresql+psycopg://predicta:predicta@localhost:5432/predicta

# Immutable raw store (filesystem in development). S3 remains a deferred decision.
PREDICTA_INGESTION_RAW_STORE_PATH=./var/raw
PREDICTA_INGESTION_MAX_PAYLOAD_BYTES=2000000

# Sportmonks Football API (Growth). Leave empty here. Copy this file to `.env`
# and set the token locally. The CLI loads that file automatically; do not export
# it in the shell. The value must never be committed or printed.
SPORTMONKS_API_TOKEN=

# Live ingestion stays off until you explicitly set both:
# PREDICTA_INGESTION_ENABLE_LIVE=true
# PREDICTA_INGESTION_DATA_MODE=live
# There is no mock fallback when live is requested.

# Other providers remain unconnected except The Odds API, which is opt-in.
PREDICTA_INGESTION_API_FOOTBALL_KEY=
PREDICTA_INGESTION_SPORTMONKS_KEY=
# The Odds API (football 1X2 / h2h). Leave empty here. Copy to `.env` locally.
# Live odds stay off until ENABLE_LIVE=true, DATA_MODE=live, and a key is set.
# Unprefixed THE_ODDS_API_KEY is also accepted. Never commit a real key.
PREDICTA_INGESTION_THE_ODDS_API_KEY=
# THE_ODDS_API_KEY=
PREDICTA_INGESTION_THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
PREDICTA_INGESTION_THE_ODDS_API_REGIONS=eu
PREDICTA_INGESTION_BALLDONTLIE_KEY=
PREDICTA_INGESTION_API_TENNIS_KEY=
