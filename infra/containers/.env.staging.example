# Staging-shaped compose. Copy to `.env.staging` (gitignored) and pass:
#   docker compose -f infra/containers/compose.staging.yml --env-file infra/containers/.env.staging up --build
# Never put live provider tokens or bootstrap passwords in this file.

PREDICTA_API_ENV=staging
PREDICTA_API_REPOSITORY=sql
PREDICTA_API_DATA_MODE=live
# Temporary product-testing hatch (local/staging only). Production refuses this
# at API boot. Set true to skip login; compose also inlines it as
# NEXT_PUBLIC_PREDICTA_AUTH_BYPASS at web build time. Rebuild web after changing it.
PREDICTA_API_AUTH_BYPASS=false
PREDICTA_API_LOG_LEVEL=INFO

# Browser origin for the web container. Must match the URL users open.
PREDICTA_API_CORS_ORIGINS=http://localhost:3000
PREDICTA_WEB_API_BASE_URL=http://localhost:8000/api/v1

# Invite-only allowlist (comma-separated emails). Provision users after boot.
PREDICTA_API_INVITE_ALLOWLIST=

# HTTP local compose only. Omit this variable (or set true) behind TLS.
PREDICTA_API_COOKIE_SECURE=false

# Local compose default credentials. Replace on any shared VM.
POSTGRES_DB=predicta
POSTGRES_USER=predicta
POSTGRES_PASSWORD=predicta

PREDICTA_API_HOST_PORT=8000
PREDICTA_WEB_HOST_PORT=3000

# Frozen football-elo-v1-candidate (not champion). Not in Git; not in the image.
# Laptop source of truth (compose defaults; gitignored):
#   workers/ingestion/var/football-1x2-history.parquet
#   workers/ml/var/registry/football-elo-v1-candidate/
# Isolated copy (after ./infra/containers/prepare-staging-football-data.sh):
#   PREDICTA_FOOTBALL_DATASETS_HOST=../../var/football/datasets
#   PREDICTA_FOOTBALL_REGISTRY_HOST=../../var/football/registry
#   PREDICTA_FOOTBALL_RAW_HOST=../../var/football/raw
# Paths inside the API container. Missing artefact/parquet → RFC 9457 503/422, never mock.
PREDICTA_FOOTBALL_DATASETS_HOST=../../workers/ingestion/var
PREDICTA_FOOTBALL_REGISTRY_HOST=../../workers/ml/var/registry
PREDICTA_FOOTBALL_RAW_HOST=../../workers/ingestion/var/raw
PREDICTA_API_FOOTBALL_MODEL_VERSION=football-elo-v1-candidate
PREDICTA_API_FOOTBALL_REGISTRY_DIR=/data/football/registry
PREDICTA_API_FOOTBALL_DATASET_PATH=/data/football/datasets/football-1x2-history.parquet
PREDICTA_API_FOOTBALL_PREMATCH_DATASET_PATH=/data/football/datasets/football-1x2-prematch.parquet
PREDICTA_API_FOOTBALL_RAW_ARCHIVE_DIR=/data/football/raw

NEXT_PUBLIC_PREDICTA_ENV=staging
NEXT_PUBLIC_PREDICTA_DATA_SOURCE=http
NEXT_PUBLIC_PREDICTA_ALLOW_MOCK_IN_PROD=false
# Inlined at image build. Ignored when NEXT_PUBLIC_PREDICTA_ENV=production.
# Compose copies PREDICTA_API_AUTH_BYPASS into this build arg; keep them aligned.
NEXT_PUBLIC_PREDICTA_AUTH_BYPASS=false
